# Local development only (`npm run dev`).
#
# Docker Compose sets every one of these itself and never reads this file, so
# `docker compose up` needs no .env at all. Copy this to .env only when running
# the backend on the host against containerised dependencies -- note the
# hostnames below are localhost, where Compose would use service names.

NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://rps:rps_dev_password@localhost:5432/rps_db

RABBITMQ_URL=amqp://rps:rps_dev_password@localhost:5672
RABBITMQ_QUEUE=inference.jobs
RABBITMQ_DLX=inference.dlx
RABBITMQ_DLQ=inference.jobs.failed

# LocalStack. Pointing this at real AWS is the only change the code needs to
# use a real bucket, which is why it has no default.
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=rps-inference
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# 10 MB.
MAX_UPLOAD_BYTES=10485760

# Where Vite's dev server runs. In Compose the browser only ever talks to
# nginx on one origin, so CORS is not exercised at all.
CORS_ORIGIN=http://localhost:5173
