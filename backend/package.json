{
  "name": "rps-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API that accepts images, stores them in S3 and queues them for the Python inference worker",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && copyfiles -u 1 \"src/db/*.sql\" dist",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "amqplib": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "copyfiles": "^2.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
